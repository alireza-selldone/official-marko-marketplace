{
  "name": "selldone-marko-marketplace",
  "scripts": {
    "build": "npm run build:static",
    "build:static": "node scripts/build-static.mjs",
    "build:pages": "node scripts/build-pages.mjs && node scripts/build-blog-pages.mjs",
    "dev": "npm run dev:static",
    "dev:static": "node scripts/dev-static.mjs",
    "deploy": "npx wrangler deploy",
    "deploy:worker": "npx wrangler deploy",
    "deploy:worker-version": "npx wrangler versions upload",
    "preview": "npm run preview:static",
    "preview:static": "npm run build:static && node scripts/dev-static.mjs --dist",
    "start": "npm run dev:static",
    "check": "npm run check:leak && npm run check:variants && npm run check:audit && npm run check:images && npm run check:pages && npm run check:controls && npm run check:hero && npm run check:port",
    "check:audit": "node scripts/audit-run.mjs",
    "check:images": "node scripts/imgsweep.mjs",
    "check:pages": "node scripts/pagecheck.mjs",
    "check:controls": "node scripts/deadctl.mjs",
    "check:hero": "node scripts/herocheck.mjs",
    "setup": "node scripts/setup.mjs",
    "check:port": "node scripts/portcheck.mjs",
    "check:leak": "node scripts/leakcheck.mjs",
    "check:variants": "node scripts/variant-sizecheck.mjs"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.122.0"
  }
}
